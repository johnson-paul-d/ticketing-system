PORT=

EMAIL_USER=
EMAIL_PASS=

ADMIN_EMAIL=

SUPABASE_URL=

JWT_SECRET=

SUPABASE_SERVICE_ROLE_KEY=


RESEND_API_KEY=

# Free key at aistudio.google.com → Get API Key (no credit card needed)
GEMINI_API_KEY=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
 
LINKEDIN_REDIRECT_URI=
FRONTEND_URL=

# --- Google Drive (expense receipts) ---
# Scope: drive.file. Consent screen must be PUBLISHED to Production,
# otherwise Google expires the refresh token every 7 days.
FILE_STORE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Still needed - see chat for how to obtain these two:
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Shared secret for the Salesforce webhook (sent as the x-webhook-secret header)
SALESFORCE_WEBHOOK_SECRET=

# --- Hosting / CORS ---
# Comma-separated extra browser origins allowed alongside FRONTEND_URL
# (e.g. the old Vercel address during a domain move, or a *.pages.dev preview).
ALLOWED_ORIGINS=
# Public address of this API, used in the OpenAPI document and MCP discovery.
PUBLIC_API_URL=
PUBLIC_BACKEND_URL=

# --- Single-origin deployment (Cloudflare Tunnel / own server) ---
# When frontend/dist exists the backend serves it on the same port. Build it
# with: npm run build:frontend (from backend/). Override the folder if needed.
STATIC_DIR=
